# --- Service ---
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
# Compilations (donc Chromium) simultanées, tous workers confondus
CHROMIUM_CONCURRENCY=3
# Regroupement des demandes d'une même page, en ms
DEBOUNCE_MS=30000
# Jeton pour GET /v1/admin/overview
ADMIN_TOKEN=change-moi

# --- Sites ---
# Fichier de configuration des sites (ou SITES_YAML avec le contenu YAML directement)
SITES_FILE=config/sites.yml
# Secret de chaque site : champ « secret » dans la configuration (le plus simple),
# ou variable nommée par « secret_env » :
# SECRET_SITE_27=change-moi
# Délai avant de reprendre une page dont le site est déjà en cours de compilation (ms)
SITE_RETRY_DELAY_MS=5000

# --- Compilation ---
MAX_ATTEMPTS=3
MEASURE_RUNS=3
NOISE_CHECK=true
# Contrôle de départ : la page sans optimisation doit déjà être identique à l'original
BASELINE_CHECK=true
VISUAL_THRESHOLD=0.005
FULLPAGE_THRESHOLD=0.01
HEIGHT_TOLERANCE=0.02
LCP_TOLERANCE=1.05
NAVIGATION_MODE=prefetch
PAGE_TIMEOUT_MS=60000
DATA_DIR=data
ARTIFACTS_RETENTION_DAYS=30

# --- Chromium (hors Docker) ---
# CHROMIUM_PATH=/usr/bin/google-chrome
# CHROMIUM_EXTRA_ARGS=
