# --- Service ---
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
# Compilations (donc Chromium) simultanées, tous workers confondus
CHROMIUM_CONCURRENCY=3
# Regroupement des demandes d'une même page, en ms
DEBOUNCE_MS=30000
# Jeton pour GET /v1/admin/overview
ADMIN_TOKEN=change-moi

# --- Base de données et interface /admin ---
# PostgreSQL (le docker-compose le construit à partir de POSTGRES_PASSWORD)
DATABASE_URL=postgres://page_compiler:change-moi@127.0.0.1:5432/page_compiler
POSTGRES_PASSWORD=change-moi
# Chiffre les clés des sites et la clé PageSpeed en base : openssl rand -hex 32.
# À conserver précieusement : la changer rend les clés existantes illisibles.
MASTER_KEY=change-moi-par-64-caracteres-hexadecimaux
# Premier compte administrateur (créé au démarrage s'il n'existe aucun compte)
ADMIN_EMAIL=vous@exemple.fr
ADMIN_PASSWORD=change-moi-10-caracteres-minimum
# Clé PageSpeed Insights (facultative : sinon saisie dans l'interface)
PAGESPEED_API_KEY=
SESSION_TTL_HOURS=12
PAIRING_TTL_MINUTES=15

# --- Sites (transition : les sites s'enregistrent désormais dans l'interface /admin) ---
# Fichier de configuration des sites (ou SITES_YAML avec le contenu YAML directement)
SITES_FILE=config/sites.yml
# Secret de chaque site : champ « secret » dans la configuration (le plus simple),
# ou variable nommée par « secret_env » :
# SECRET_SITE_27=change-moi
# Délai avant de reprendre une page dont le site est déjà en cours de compilation (ms)
SITE_RETRY_DELAY_MS=5000

# --- Compilation ---
MAX_ATTEMPTS=4
MEASURE_RUNS=3
NOISE_CHECK=true
# Contrôle de départ : la page sans optimisation doit déjà être identique à l'original
BASELINE_CHECK=true
VISUAL_THRESHOLD=0.005
FULLPAGE_THRESHOLD=0.01
HEIGHT_TOLERANCE=0.02
LCP_TOLERANCE=1.05
NAVIGATION_MODE=prefetch
PAGE_TIMEOUT_MS=60000
DATA_DIR=data
ARTIFACTS_RETENTION_DAYS=30

# --- Chromium (hors Docker) ---
# CHROMIUM_PATH=/usr/bin/google-chrome
# CHROMIUM_EXTRA_ARGS=
